# 이 파일을 복사해 .env 로 만들고 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# AI 설정 — 둘 중 하나를 고른다
# (A) OpenAI GPT (유료)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=500

# (B) Google Gemini 무료 키 (OpenAI 호환 주소 사용)
OPENAI_API_KEY=Gemini_API_키
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
OPENAI_MAX_TOKENS=1500

# Firebase (둘 중 하나)
# 로컬: 내려받은 서비스 계정 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# 배포(Render): 키 파일 내용 전체(JSON)를 한 줄로
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS 허용 도메인 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# (보너스) 매매 신호 디스코드 알림 — 비워 두면 알림 기능만 꺼진다
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_TOKEN=아무도_못_맞힐_긴_문자열
# ALERT_MODE=risk    # risk: '주의' 이상으로 오르면 경고·내려오면 해제 / change: 단계가 바뀔 때마다 / daily: 매일
# FRONTEND_URL=https://crypto-ai-assistant-frontend-lake.vercel.app
